PORT=5000
CLIENT_ORIGIN=http://localhost:5173
ANALYTICS_PASSWORD=1
SESSION_SECRET=change_this_to_a_long_random_string

# --- Email notifications for the message/suggestion form ---
# GMAIL_USER sends the mail, NOTIFY_EMAIL receives it (they can be different Gmail accounts).
# GMAIL_APP_PASSWORD must be a Gmail "app password", not your normal login password:
# https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled).
GMAIL_USER=gmail1@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
NOTIFY_EMAIL=gmail2@gmail.com
